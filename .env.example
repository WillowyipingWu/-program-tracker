# ======================================================================
# BYOK (Bring Your Own Key): every visitor types their own API key into
# the web page. The server does NOT hold a shared key for public use —
# none of the variables below are secrets a visitor needs. See README
# "AI Key / BYOK" for the full explanation.
# ======================================================================

# Optional: which provider's selector is pre-selected in the UI, and
# which provider /api/health reports as the default. Visitors can still
# pick the other one in the settings panel. ark | anthropic
LLM_PROVIDER=ark

# Optional non-secret default model NAME per provider, so a visitor
# doesn't have to type a model ID every time — they can still override
# it in the settings panel. Leave blank to force visitors to supply one.
ARK_MODEL=
ANTHROPIC_MODEL=claude-sonnet-5

# Ark's API base URL. This is NEVER accepted from a visitor's request —
# only from this file — because allowing a caller to redirect the
# server's outbound HTTP calls would be an SSRF vector. Leave as the
# default unless you have a specific reason to change it.
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ---- Which service finds the official page URLs (optional) ----
# ark | anthropic | none
# "none" (default) means a visitor must paste the official admissions
# URL themselves. Visitors can also opt into automatic search per
# query (checkbox in the UI) — when they do, it uses their own key.
SEARCH_PROVIDER=none

# ---- ONLY for a private/personal deployment, never a public one ----
# Setting a real key here makes it a SHARED key: anyone who can reach
# this server could spend your quota, bypassing BYOK entirely. Leave
# both blank for any deployment other people might use.
ARK_API_KEY=
ANTHROPIC_API_KEY=

# ---- Server ----
PORT=3000
# This limits requests per IP to protect the SERVER's own bandwidth/CPU
# (fetching pages, running the pipeline) — not AI spend, since every
# visitor pays for their own API calls with their own key.
RATE_LIMIT_PER_HOUR=20
CACHE_TTL_DAYS=7
# Set to 1 only if you run behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=0
